@model WebCRUDMVCSQL.Models.Clientes

@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="container mt-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-danger text-white rounded-top-4">
            <h2 class="mb-0">🗑️ Excluir Cliente</h2>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning rounded-4">
                <strong>Atenção!</strong> Esta ação não poderá ser desfeita.
            </div>

            <h5 class="mb-4">
                Tem certeza que deseja excluir este cliente?
            </h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Nome:</strong><br />
                    @Html.DisplayFor(model => model.Nome)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Idade:</strong><br />
                    @Html.DisplayFor(model => model.Idade)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Sexo:</strong><br />
                    @Html.DisplayFor(model => model.Sexo)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Estado Civil:</strong><br />
                    @Html.DisplayFor(model => model.EstadoCivil)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Endereço:</strong><br />
                    @Html.DisplayFor(model => model.Endereco)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>CEP:</strong><br />
                    @Html.DisplayFor(model => model.CEP)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Logradouro:</strong><br />
                    @Html.DisplayFor(model => model.Logradouro)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Número:</strong><br />
                    @Html.DisplayFor(model => model.NumeroCasa)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Complemento:</strong><br />
                    @Html.DisplayFor(model => model.Complemento)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Bairro:</strong><br />
                    @Html.DisplayFor(model => model.Bairro)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Cidade:</strong><br />
                    @Html.DisplayFor(model => model.Cidade)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Estado:</strong><br />
                    @Html.DisplayFor(model => model.Estado)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>País:</strong><br />
                    @Html.DisplayFor(model => model.Pais)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>WhatsApp:</strong><br />
                    @Html.DisplayFor(model => model.Whatsapp)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>CPF:</strong><br />
                    @Html.DisplayFor(model => model.CPF)
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Email:</strong><br />
                    @Html.DisplayFor(model => model.Email)
                </div>

            </div>

            <hr />

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">
                        🗑️ Excluir
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        ← Voltar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
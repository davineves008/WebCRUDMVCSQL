@model WebCRUDMVCSQL.Models.Clientes

@{
    ViewData["Title"] = "Cadastrar Cliente";
}

<h1>Cadastrar Cliente</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Erro
            </div>
        }

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- NOME -->
            <div class="form-group mb-3">
                <label asp-for="Nome" class="control-label"></label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Digite seu nome" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>
            </div>

            <!-- IDADE -->
            <div class="form-group mb-3">
                <label asp-for="Idade" class="control-label"></label>

                <input asp-for="Idade"
                       type="number"
                       min="1"
                       class="form-control"
                       placeholder="Digite sua idade" />

                <span asp-validation-for="Idade"
                      class="text-danger">
                </span>
            </div>

            <!-- SEXO -->
            <div class="form-group mb-3">
                <label asp-for="Sexo" class="control-label"></label>

                <select asp-for="Sexo" class="form-control">
                    <option value="">Selecione</option>
                    <option>Masculino</option>
                    <option>Feminino</option>
                    <option>Outro</option>
                </select>

                <span asp-validation-for="Sexo"
                      class="text-danger">
                </span>
            </div>

            <!-- ESTADO CIVIL -->
            <div class="form-group mb-3">
                <label asp-for="Estado_Civil"
                       class="control-label">
                </label>

                <select asp-for="Estado_Civil"
                        class="form-control">

                    <option value="">Selecione</option>
                    <option>Solteiro(a)</option>
                    <option>Casado(a)</option>
                    <option>Divorciado(a)</option>
                    <option>Viúvo(a)</option>
                </select>

                <span asp-validation-for="Estado_Civil"
                      class="text-danger">
                </span>
            </div>

            <!-- ENDEREÇO -->
            <div class="form-group mb-3">
                <label asp-for="Endereco" class="control-label"></label>

                <input asp-for="Endereco"
                       class="form-control"
                       placeholder="Digite seu endereço" />

                <span asp-validation-for="Endereco"
                      class="text-danger">
                </span>
            </div>

            <!-- CEP -->
            <div class="form-group mb-3">
                <label asp-for="CEP" class="control-label"></label>

                <input asp-for="CEP"
                       class="form-control"
                       placeholder="00000-000" />

                <span asp-validation-for="CEP"
                      class="text-danger">
                </span>
            </div>

            <!-- LOGRADOURO -->
            <div class="form-group mb-3">
                <label asp-for="Logradouro"
                       class="control-label">
                </label>

                <input asp-for="Logradouro"
                       class="form-control"
                       placeholder="Rua/Avenida" />

                <span asp-validation-for="Logradouro"
                      class="text-danger">
                </span>
            </div>

            <!-- NUMERO CASA -->
            <div class="form-group mb-3">
                <label asp-for="Numero_Casa"
                       class="control-label">
                </label>

                <input asp-for="Numero_Casa"
                       type="number"
                       min="1"
                       class="form-control"
                       placeholder="Número da casa" />

                <span asp-validation-for="Numero_Casa"
                      class="text-danger">
                </span>
            </div>

            <!-- COMPLEMENTO -->
            <div class="form-group mb-3">
                <label asp-for="Complemento"
                       class="control-label">
                </label>

                <input asp-for="Complemento"
                       class="form-control"
                       placeholder="Apartamento, bloco..." />

                <span asp-validation-for="Complemento"
                      class="text-danger">
                </span>
            </div>

            <!-- BAIRRO -->
            <div class="form-group mb-3">
                <label asp-for="Bairro" class="control-label"></label>

                <input asp-for="Bairro"
                       class="form-control"
                       placeholder="Digite o bairro" />

                <span asp-validation-for="Bairro"
                      class="text-danger">
                </span>
            </div>

            <!-- CIDADE -->
            <div class="form-group mb-3">
                <label asp-for="Cidade" class="control-label"></label>

                <input asp-for="Cidade"
                       class="form-control"
                       placeholder="Digite a cidade" />

                <span asp-validation-for="Cidade"
                      class="text-danger">
                </span>
            </div>

            <!-- ESTADO -->
            <div class="form-group mb-3">
                <label asp-for="Estado" class="control-label"></label>

                <input asp-for="Estado"
                       class="form-control"
                       placeholder="Digite o estado" />

                <span asp-validation-for="Estado"
                      class="text-danger">
                </span>
            </div>

            <!-- PAIS -->
            <div class="form-group mb-3">
                <label asp-for="Pais" class="control-label"></label>

                <input asp-for="Pais"
                       class="form-control"
                       placeholder="Digite o país" />

                <span asp-validation-for="Pais"
                      class="text-danger">
                </span>
            </div>

            <!-- WHATSAPP -->
            <div class="form-group mb-3">
                <label asp-for="Whatsapp"
                       class="control-label">
                </label>

                <input asp-for="Whatsapp"
                       class="form-control"
                       placeholder="(00) 00000-0000" />

                <span asp-validation-for="Whatsapp"
                      class="text-danger">
                </span>
            </div>

            <!-- CPF -->
            <div class="form-group mb-3">
                <label asp-for="CPF" class="control-label"></label>

                <input asp-for="CPF"
                       class="form-control"
                       placeholder="000.000.000-00" />

                <span asp-validation-for="CPF"
                      class="text-danger">
                </span>
            </div>

            <!-- EMAIL -->
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Digite seu email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <!-- BOTÃO -->
            <div class="form-group mt-4">
                <input type="submit"
                       value="Cadastrar"
                       class="btn btn-primary w-100" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">
        Voltar
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
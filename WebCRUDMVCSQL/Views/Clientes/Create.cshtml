@model WebCRUDMVCSQL.Models.Clientes

@{
    ViewData["Title"] = "Cadastrar Cliente";
}

<div class="container mt-4">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-primary text-white rounded-top-4">
            <h2 class="mb-0">👤 Cadastrar Cliente</h2>
        </div>

        <div class="card-body p-4">

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger rounded-4">
                    @ViewBag.Erro
                </div>
            }

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-4">
                </div>

                <div class="row">

                    <!-- NOME -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label fw-bold"></label>
                        <input asp-for="Nome"
                               class="form-control rounded-3"
                               placeholder="Digite seu nome" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <!-- IDADE -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Idade" class="form-label fw-bold"></label>
                        <input asp-for="Idade"
                               type="number"
                               min="1"
                               class="form-control rounded-3"
                               placeholder="Digite sua idade" />
                        <span asp-validation-for="Idade" class="text-danger"></span>
                    </div>

                    <!-- SEXO -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Sexo" class="form-label fw-bold"></label>
                        <select asp-for="Sexo" class="form-select rounded-3">
                            <option value="">Selecione</option>
                            <option>Masculino</option>
                            <option>Feminino</option>
                            <option>Outro</option>
                        </select>
                        <span asp-validation-for="Sexo" class="text-danger"></span>
                    </div>

                    <!-- ESTADO CIVIL -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="EstadoCivil" class="form-label fw-bold"></label>
                        <select asp-for="EstadoCivil" class="form-select rounded-3">
                            <option value="">Selecione</option>
                            <option>Solteiro(a)</option>
                            <option>Casado(a)</option>
                            <option>Divorciado(a)</option>
                            <option>Viúvo(a)</option>
                        </select>
                        <span asp-validation-for="EstadoCivil" class="text-danger"></span>
                    </div>

                    <!-- ENDEREÇO -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Endereco" class="form-label fw-bold"></label>
                        <input asp-for="Endereco"
                               class="form-control rounded-3"
                               placeholder="Digite seu endereço" />
                        <span asp-validation-for="Endereco" class="text-danger"></span>
                    </div>

                    <!-- CEP -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="CEP" class="form-label fw-bold"></label>
                        <input asp-for="CEP"
                               class="form-control rounded-3"
                               placeholder="00000-000" />
                        <span asp-validation-for="CEP" class="text-danger"></span>
                    </div>

                    <!-- LOGRADOURO -->
                    <div class="col-md-8 mb-3">
                        <label asp-for="Logradouro" class="form-label fw-bold"></label>
                        <input asp-for="Logradouro"
                               class="form-control rounded-3"
                               placeholder="Rua/Avenida" />
                        <span asp-validation-for="Logradouro" class="text-danger"></span>
                    </div>

                    <!-- NÚMERO -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="NumeroCasa" class="form-label fw-bold"></label>
                        <input asp-for="NumeroCasa"
                               type="number"
                               min="1"
                               class="form-control rounded-3"
                               placeholder="Número" />
                        <span asp-validation-for="NumeroCasa" class="text-danger"></span>
                    </div>

                    <!-- COMPLEMENTO -->
                    <div class="col-md-8 mb-3">
                        <label asp-for="Complemento" class="form-label fw-bold"></label>
                        <input asp-for="Complemento"
                               class="form-control rounded-3"
                               placeholder="Apartamento, bloco..." />
                        <span asp-validation-for="Complemento" class="text-danger"></span>
                    </div>

                    <!-- BAIRRO -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Bairro" class="form-label fw-bold"></label>
                        <input asp-for="Bairro"
                               class="form-control rounded-3"
                               placeholder="Bairro" />
                        <span asp-validation-for="Bairro" class="text-danger"></span>
                    </div>

                    <!-- CIDADE -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Cidade" class="form-label fw-bold"></label>
                        <input asp-for="Cidade"
                               class="form-control rounded-3"
                               placeholder="Cidade" />
                        <span asp-validation-for="Cidade" class="text-danger"></span>
                    </div>

                    <!-- ESTADO -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Estado" class="form-label fw-bold"></label>
                        <input asp-for="Estado"
                               class="form-control rounded-3"
                               placeholder="Estado" />
                        <span asp-validation-for="Estado" class="text-danger"></span>
                    </div>

                    <!-- PAÍS -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Pais" class="form-label fw-bold"></label>
                        <input asp-for="Pais"
                               class="form-control rounded-3"
                               placeholder="País" />
                        <span asp-validation-for="Pais" class="text-danger"></span>
                    </div>

                    <!-- WHATSAPP -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Whatsapp" class="form-label fw-bold"></label>
                        <input asp-for="Whatsapp"
                               class="form-control rounded-3"
                               placeholder="(00) 00000-0000" />
                        <span asp-validation-for="Whatsapp" class="text-danger"></span>
                    </div>

                    <!-- CPF -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CPF" class="form-label fw-bold"></label>
                        <input asp-for="CPF"
                               class="form-control rounded-3"
                               placeholder="000.000.000-00" />
                        <span asp-validation-for="CPF" class="text-danger"></span>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email"
                               class="form-control rounded-3"
                               placeholder="Digite seu email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success rounded-pill px-4">
                        💾 Cadastrar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        ← Voltar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
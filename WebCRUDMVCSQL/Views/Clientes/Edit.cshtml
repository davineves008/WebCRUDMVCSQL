@model WebCRUDMVCSQL.Models.Clientes

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-warning text-dark text-center py-3 rounded-top-4">
            <h2 class="mb-0">✏️ Editar Cliente</h2>
        </div>

        <div class="card-body p-4">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label fw-bold"></label>
                        <input asp-for="Nome" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Idade" class="form-label fw-bold"></label>
                        <input asp-for="Idade" type="number" min="1" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Sexo" class="form-label fw-bold"></label>
                        <input asp-for="Sexo" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EstadoCivil" class="form-label fw-bold"></label>
                        <input asp-for="EstadoCivil" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Endereco" class="form-label fw-bold"></label>
                        <input asp-for="Endereco" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="CEP" class="form-label fw-bold"></label>
                        <input asp-for="CEP" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Logradouro" class="form-label fw-bold"></label>
                        <input asp-for="Logradouro" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="NumeroCasa" class="form-label fw-bold"></label>
                        <input asp-for="NumeroCasa" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Complemento" class="form-label fw-bold"></label>
                        <input asp-for="Complemento" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Bairro" class="form-label fw-bold"></label>
                        <input asp-for="Bairro" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Cidade" class="form-label fw-bold"></label>
                        <input asp-for="Cidade" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Estado" class="form-label fw-bold"></label>
                        <input asp-for="Estado" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Pais" class="form-label fw-bold"></label>
                        <input asp-for="Pais" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Whatsapp" class="form-label fw-bold"></label>
                        <input asp-for="Whatsapp" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CPF" class="form-label fw-bold"></label>
                        <input asp-for="CPF" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control rounded-3" />
                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4">
                        Salvar Alterações
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
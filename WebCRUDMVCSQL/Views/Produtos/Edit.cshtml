@model WebCRUDMVCSQL.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-warning text-dark text-center rounded-top-4">
            <h2 class="mb-0">✏️ Editar Produto</h2>
        </div>

        <div class="card-body p-4">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label fw-bold">
                    </label>

                    <input asp-for="Nome"
                           class="form-control form-control-lg rounded-pill" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Peso" class="form-label fw-bold">
                    </label>

                    <input asp-for="Peso"
                           class="form-control form-control-lg rounded-pill" />

                    <span asp-validation-for="Peso"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Preco" class="form-label fw-bold">
                    </label>

                    <input asp-for="Preco"
                           class="form-control form-control-lg rounded-pill" />

                    <span asp-validation-for="Preco"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4">
                        💾 Salvar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        ↩ Voltar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model WebCRUDMVCSQL.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">🗑 Excluir Produto</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Atenção!</strong> Esta ação não poderá ser desfeita.
            </div>

            <div class="row mb-4">
                <div class="col-md-4 fw-bold">
                    Nome:
                </div>

                <div class="col-md-8">
                    @Model.Nome
                </div>
            </div>

            <hr />

            <div class="row mb-4">
                <div class="col-md-4 fw-bold">
                    Peso:
                </div>

                <div class="col-md-8">
                    @Model.Peso kg
                </div>
            </div>

            <hr />

            <div class="row mb-4">
                <div class="col-md-4 fw-bold">
                    Preço:
                </div>

                <div class="col-md-8">
                    @Model.Preco.ToString("C")
                </div>
            </div>

        </div>

        <div class="card-footer bg-light">

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger rounded-pill px-4">
                        🗑 Confirmar Exclusão
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        ⬅ Voltar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
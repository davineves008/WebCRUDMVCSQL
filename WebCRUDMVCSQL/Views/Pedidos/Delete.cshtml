@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Excluir Pedido";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-danger text-white text-center py-3 rounded-top-4">
            <h2 class="mb-0">🗑️ Excluir Pedido</h2>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning text-center rounded-3">
                <strong>Atenção!</strong><br />
                Esta ação não poderá ser desfeita.
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Cliente:</strong>
                    <p class="text-muted">@Model.ClienteId</p>
                </div>

                <div class="col-md-6">
                    <strong>Usuário:</strong>
                    <p class="text-muted">@Model.UsuarioId</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Produto:</strong>
                    <p class="text-muted">@Model.ProdutoId</p>
                </div>

                <div class="col-md-6">
                    <strong>Quantidade:</strong>
                    <p class="text-muted">@Model.Quantidade</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Valor Total:</strong>
                    <p class="text-success fw-bold">
                        R$ @Model.ValorTotal.ToString("N2")
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Data do Pedido:</strong>
                    <p class="text-muted">
                        @Model.DataPedido.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>

            <hr />

            <form asp-action="Delete" class="text-center">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger rounded-pill px-4 me-2">
                    🗑️ Excluir Pedido
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary rounded-pill px-4">
                    ← Voltar
                </a>

            </form>

        </div>

    </div>

</div>
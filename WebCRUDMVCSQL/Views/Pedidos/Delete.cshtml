@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Excluir Pedido";
}

<h1>Excluir Pedido</h1>

<h3>Tem certeza que deseja excluir este pedido?</h3>

<div>
    <hr />

    <dl class="row">

        <!-- CLIENTE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ClienteId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ClienteId)
        </dd>

        <!-- USUARIO -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UsuarioId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UsuarioId)
        </dd>

        <!-- PRODUTO -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProdutoId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProdutoId)
        </dd>

        <!-- QUANTIDADE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Quantidade)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Quantidade)
        </dd>

        <!-- VALOR TOTAL -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ValorTotal)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ValorTotal)
        </dd>

        <!-- DATA PEDIDO -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataPedido)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataPedido)
        </dd>

    </dl>

    <form asp-action="Delete">

        <input type="hidden" asp-for="Id" />

        <input type="submit"
               value="Excluir"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </form>
</div>
@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Detalhes do Pedido";
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-info text-white text-center rounded-top-4">
            <h2 class="mb-0">📦 Detalhes do Pedido</h2>
        </div>

        <div class="card-body p-4">

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>ID do Pedido:</strong>
                    <span class="badge bg-secondary fs-6">
                        @Model.Id
                    </span>
                </div>

                <div class="col-md-6">
                    <strong>Data:</strong>
                    @Model.DataPedido.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-6">
                    <strong>👤 Cliente:</strong><br />
                    @(Model.Cliente?.Nome ?? Model.ClienteId.ToString())
                </div>

                <div class="col-md-6">
                    <strong>🧑 Usuário:</strong><br />
                    @(Model.Usuario?.Nome ?? Model.UsuarioId.ToString())
                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-6">
                    <strong>📦 Produto:</strong><br />
                    @(Model.Produto?.Nome ?? Model.ProdutoId.ToString())
                </div>

                <div class="col-md-6">
                    <strong>🔢 Quantidade:</strong><br />
                    @Model.Quantidade
                </div>

            </div>

            <div class="row">

                <div class="col-md-12">
                    <strong>💰 Valor Total:</strong><br />

                    <span class="fs-4 text-success fw-bold">
                        @Model.ValorTotal.ToString("C")
                    </span>
                </div>

            </div>

        </div>

        <div class="card-footer bg-light d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning rounded-pill px-4">
                ✏️ Editar
            </a>

            <a asp-action="Index"
               class="btn btn-secondary rounded-pill px-4">
                ↩ Voltar
            </a>

        </div>

    </div>

</div>
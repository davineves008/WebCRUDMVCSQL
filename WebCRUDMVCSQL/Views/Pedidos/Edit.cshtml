@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Editar Pedido";
}

<div class="container mt-5">

    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-warning text-dark text-center rounded-top-4">
            <h2 class="mb-0">✏️ Editar Pedido</h2>
        </div>

        <div class="card-body p-4">

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger rounded-3">
                    @ViewBag.Erro
                </div>
            }

            <form asp-action="Edit">

                <input type="hidden" asp-for="Id" />

                <!-- CLIENTE -->
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Cliente
                    </label>

                    <select asp-for="ClienteId"
                            class="form-select rounded-pill"
                            asp-items="ViewBag.Clientes">
                    </select>

                    <span asp-validation-for="ClienteId"
                          class="text-danger">
                    </span>
                </div>

                <!-- USUÁRIO -->
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Usuário
                    </label>

                    <select asp-for="UsuarioId"
                            class="form-select rounded-pill"
                            asp-items="ViewBag.Usuarios">
                    </select>

                    <span asp-validation-for="UsuarioId"
                          class="text-danger">
                    </span>
                </div>

                <!-- PRODUTO -->
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Produto
                    </label>

                    <select asp-for="ProdutoId"
                            class="form-select rounded-pill"
                            asp-items="ViewBag.Produtos">
                    </select>

                    <span asp-validation-for="ProdutoId"
                          class="text-danger">
                    </span>
                </div>

                <!-- QUANTIDADE -->
                <div class="mb-3">
                    <label asp-for="Quantidade"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Quantidade"
                           type="number"
                           min="1"
                           class="form-control form-control-lg rounded-pill" />

                    <span asp-validation-for="Quantidade"
                          class="text-danger">
                    </span>
                </div>

                <!-- VALOR TOTAL -->
                <div class="mb-3">
                    <label asp-for="ValorTotal"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="ValorTotal"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control form-control-lg rounded-pill" />

                    <span asp-validation-for="ValorTotal"
                          class="text-danger">
                    </span>
                </div>

                <!-- DATA -->
                <div class="mb-4">
                    <label asp-for="DataPedido"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="DataPedido"
                           type="date"
                           class="form-control form-control-lg rounded-pill" />

                    <span asp-validation-for="DataPedido"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning rounded-pill px-4">
                        💾 Salvar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        ↩ Voltar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Novo Pedido";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
            <h2 class="mb-0">🛒 Novo Pedido</h2>
        </div>

        <div class="card-body p-4">

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger rounded-3">
                    @ViewBag.Erro
                </div>
            }

            <form asp-action="Create">

                <div class="row">

                    <!-- CLIENTE -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Cliente
                        </label>

                        <select asp-for="ClienteId"
                                class="form-select rounded-3"
                                asp-items="ViewBag.Clientes">
                            <option value="">Selecione um cliente</option>
                        </select>
                    </div>

                    <!-- USUARIO -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Usuário
                        </label>

                        <select asp-for="UsuarioId"
                                class="form-select rounded-3"
                                asp-items="ViewBag.Usuarios">
                            <option value="">Selecione um usuário</option>
                        </select>
                    </div>

                    <!-- PRODUTO -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Produto
                        </label>

                        <select asp-for="ProdutoId"
                                class="form-select rounded-3"
                                asp-items="ViewBag.Produtos">
                            <option value="">Selecione um produto</option>
                        </select>
                    </div>

                    <!-- QUANTIDADE -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Quantidade
                        </label>

                        <input asp-for="Quantidade"
                               type="number"
                               min="1"
                               class="form-control rounded-3" />
                    </div>

                    <!-- VALOR -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Valor Total
                        </label>

                        <input asp-for="ValorTotal"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control rounded-3" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Data do Pedido</label>
                        <input type="text"
                               class="form-control"
                               value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")"
                               readonly />
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2 justify-content-end">

                    <a asp-action="Index"
                       class="btn btn-secondary rounded-pill px-4">
                        Voltar
                    </a>

                    <button type="submit"
                            class="btn btn-success rounded-pill px-4">
                        Salvar Pedido
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
@model WebCRUDMVCSQL.Models.Pedido

@{
    ViewData["Title"] = "Novo Pedido";
}

<h1>Novo Pedido</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Erro
            </div>
        }

        <form asp-action="Create">

            <!-- CLIENTE -->
            <div class="form-group mb-3">
                <label class="control-label">Cliente</label>

                <select asp-for="ClienteId"
                        class="form-control"
                        asp-items="ViewBag.Clientes">
                    <option value="">Selecione um cliente</option>
                </select>
            </div>

            <!-- USUÁRIO -->
            <div class="form-group mb-3">
                <label class="control-label">Usuário</label>

                <select asp-for="UsuarioId"
                        class="form-control"
                        asp-items="ViewBag.Usuarios">
                    <option value="">Selecione um usuário</option>
                </select>
            </div>

            <!-- PRODUTO -->
            <div class="form-group mb-3">
                <label class="control-label">Produto</label>

                <select asp-for="ProdutoId"
                        class="form-control"
                        asp-items="ViewBag.Produtos">
                    <option value="">Selecione um produto</option>
                </select>
            </div>

            <!-- QUANTIDADE -->
            <div class="form-group mb-3">
                <label class="control-label">Quantidade</label>

                <input asp-for="Quantidade"
                       type="number"
                       min="1"
                       class="form-control" />
            </div>

            <!-- VALOR -->
            <div class="form-group mb-3">
                <label class="control-label">Valor Total</label>

                <input asp-for="ValorTotal"
                       type="number"
                       min="0.01"
                       step="0.01"
                       class="form-control" />
            </div>

            
            <!-- DATA -->
            <div class="form-group mb-3">
                <label class="control-label">Data do Pedido</label>

                <input asp-for="DataPedido"
                       type="datetime-local"
                       class="form-control" />
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Cadastrar Pedido"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>
            </div>

        </form>
    </div>
</div>
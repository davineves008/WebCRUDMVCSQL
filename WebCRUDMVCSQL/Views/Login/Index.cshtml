@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Login</title>

	<style>
		body {
			margin: 0;
			min-height: 100vh;
			display: flex;
			justify-content: center;
			align-items: center;
			background: #1E1E2E;
			font-family: Arial, sans-serif;
			padding: 20px;
		}

		.login-box {
			width: 380px;
			background: #2A2A40;
			padding: 50px 40px;
			border-radius: 20px;
			box-shadow: 0 10px 25px rgba(0,0,0,0.4);
		}

		h2 {
			text-align: center;
			color: white;
			margin-bottom: 35px;
		}

		input {
			width: 100%;
			padding: 14px;
			margin-bottom: 18px;
			border: none;
			border-radius: 8px;
			box-sizing: border-box;
		}

		button {
			width: 100%;
			padding: 14px;
			border: none;
			border-radius: 8px;
			background: #25679E;
			color: white;
			font-size: 16px;
			cursor: pointer;
		}

			button:hover {
				background: #1b4d77;
			}

		.cadastro-link {
			margin-top: 20px;
			text-align: center;
		}

			.cadastro-link a {
				color: white;
				text-decoration: none;
				font-size: 14px;
			}

				.cadastro-link a:hover {
					text-decoration: underline;
				}
	</style>
</head>
<body>

	<div class="login-box">

		<h2>Login</h2>

		<form action="/Login" method="post">

			<input type="email" name="email" placeholder="Digite seu email">

			<input type="password" name="senha" placeholder="Digite sua senha">

			<button type="submit">Entrar</button>

		</form>
		<div class="cadastro-link">
			<a asp-controller="Cadastro"
			   asp-action="Index">
				Criar Conta
			</a>
		</div>

	</div>

</body>
</html>



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebCRUDMVCSQL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebCRUDMVCSQL.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🛒 Sistema de Vendas
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item mx-2">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                🏠 Home
                            </a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link"
                               asp-controller="Produtos"
                               asp-action="Index">
                                📦 Produtos
                            </a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link"
                               asp-controller="Clientes"
                               asp-action="Index">
                                👥 Clientes
                            </a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link"
                               asp-controller="Pedidos"
                               asp-action="Index">
                                🧾 Pedidos
                            </a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <!-- CONTEÚDO -->
    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="mt-5 py-3 text-center text-muted border-top">
        <div class="container">
            © @DateTime.Now.Year - Sistema de Vendas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

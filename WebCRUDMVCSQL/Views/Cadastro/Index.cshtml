@{
    Layout = null;
}

@model WebCRUDMVCSQL.Models.Usuarios

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #1E1E2E, #25679E);
            padding: 30px;
        }

        .cadastro-box {
            width: 900px;
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
        }

            .cadastro-box h1 {
                text-align: center;
                margin-bottom: 30px;
                color: #25679E;
            }

        form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
        }

            .input-group label {
                margin-bottom: 8px;
                color: #333;
                font-weight: bold;
            }

            .input-group input,
            .input-group select {
                padding: 12px;
                border: 1px solid #ccc;
                border-radius: 10px;
                outline: none;
                transition: 0.3s;
            }

                .input-group input:focus,
                .input-group select:focus {
                    border-color: #25679E;
                    box-shadow: 0 0 5px rgba(37,103,158,0.5);
                }

        .full {
            grid-column: 1 / 3;
        }

        .btn-cadastrar {
            grid-column: 1 / 3;
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #25679E;
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-cadastrar:hover {
                background: #1b4d77;
            }

        .login-link {
            grid-column: 1 / 3;
            text-align: center;
            margin-top: 10px;
        }

            .login-link a {
                text-decoration: none;
                color: #25679E;
                font-weight: bold;
            }

        .erro {
            grid-column: 1 / 3;
            background: #ffebeb;
            color: #c62828;
            padding: 12px;
            border-radius: 10px;
            text-align: center;
        }

    </style>
</head>
<body>

    <div class="cadastro-box">

        <h1>Criar Conta</h1>

        <form asp-controller="Cadastro"
              asp-action="Index"
              method="post">

            @if (ViewBag.Erro != null)
            {
                <div class="erro">
                    @ViewBag.Erro
                </div>
            }

            <div class="input-group">
                <label>Nome</label>

                <input asp-for="Nome"
                       type="text"
                       placeholder="Digite seu nome">
            </div>

            <div class="input-group">
                <label>Idade</label>

                <input asp-for="Idade"
                       type="number"
                       min="1"
                       placeholder="Digite sua idade">
            </div>

            <div class="input-group">
                <label>Sexo</label>

                <select asp-for="Sexo">
                    <option value="">Selecione</option>
                    <option>Masculino</option>
                    <option>Feminino</option>
                    <option>Outro</option>
                </select>
            </div>

            <div class="input-group">
                <label>Estado Civil</label>

                <select asp-for="EstadoCivil">
                    <option value="">Selecione</option>
                    <option>Solteiro(a)</option>
                    <option>Casado(a)</option>
                    <option>Divorciado(a)</option>
                    <option>Viúvo(a)</option>
                </select>
            </div>

            <div class="input-group full">
                <label>Endereço</label>

                <input asp-for="Endereco"
                       type="text"
                       placeholder="Digite seu endereço">
            </div>

            <div class="input-group">
                <label>CEP</label>

                <input asp-for="CEP"
                       type="text"
                       placeholder="00000-000">
            </div>

            <div class="input-group">
                <label>Logradouro</label>

                <input asp-for="Logradouro"
                       type="text"
                       placeholder="Rua/Avenida">
            </div>

            <div class="input-group">
                <label>Número</label>

                <input asp-for="NumeroCasa"
                       type="number"
                       placeholder="Número da casa">
            </div>

            <div class="input-group">
                <label>Complemento</label>

                <input asp-for="Complemento"
                       type="text"
                       placeholder="Apartamento, bloco...">
            </div>

            <div class="input-group">
                <label>Bairro</label>

                <input asp-for="Bairro"
                       type="text"
                       placeholder="Digite o bairro">
            </div>

            <div class="input-group">
                <label>Cidade</label>

                <input asp-for="Cidade"
                       type="text"
                       placeholder="Digite a cidade">
            </div>

            <div class="input-group">
                <label>Estado</label>

                <input asp-for="Estado"
                       type="text"
                       placeholder="Digite o estado">
            </div>

            <div class="input-group">
                <label>País</label>

                <input asp-for="Pais"
                       type="text"
                       placeholder="Digite o país">
            </div>

            <div class="input-group">
                <label>WhatsApp</label>

                <input asp-for="Whatsapp"
                       type="text"
                       placeholder="(00) 00000-0000">
            </div>

            <div class="input-group">
                <label>CPF</label>

                <input asp-for="CPF"
                       type="text"
                       placeholder="000.000.000-00">
            </div>

            <div class="input-group">
                <label>Email</label>

                <input asp-for="Email"
                       type="email"
                       placeholder="Digite seu email">
            </div>

            <div class="input-group">
                <label>Senha</label>

                <input asp-for="Senha"
                       type="password"
                       placeholder="Digite sua senha">
            </div>

            <button type="submit" class="btn-cadastrar">
                Cadastrar
            </button>

            <div class="login-link">
                Já possui conta?
                <a href="/Login">Entrar</a>
            </div>

        </form>

    </div>

</body>
</html>